# ==============================================================================
# LIRA (Logistics Intelligence & Recovery Automation) v9.0 Environment Variables
# Buttonless ResourceLock & QpiAI Edge Architecture
# ==============================================================================

# Core Runtime
APP_ENV=development
DEBUG=true
PORT=8000
DEMO_AUTH_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./lira.db
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
WEB_ORIGIN=http://localhost:3000

# Supabase Auth & PostgreSQL Single Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# NOTE: Never expose service-role key to frontend/ESP32/Android
SUPABASE_SERVICE_ROLE_KEY=sb_secret_service_role_placeholder

# LLM & Voice Telephony Providers (Kept strictly on FastAPI backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
SARVAM_API_KEY=your_sarvam_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_WEBHOOK_SIGNING_SECRET=your_bolna_webhook_signing_secret

# QpiAI Optimization & Quantum Cloud SDK Providers
# Official QpiAI Opt API key for QUBO/HUBO dispatch solving
QPIAI_OPT_API_KEY=your_qpiai_opt_api_key_here
# QpiAI Quantum Cloud SDK API key for mapped subproblem QPU execution
QPIAI_QCLOUD_API_KEY=your_qpiai_qcloud_api_key_here

# Server-side External Risk Providers (Weather & Traffic)
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key_here
TRAFFIC_API_KEY=your_google_maps_routes_api_key_here

# Hardware Security & Edge Device HMAC Verification
# Shared secret for ESP32 DevKit V1 signing (SHA256 HMAC)
JWT_SIGNING_SECRET=generate_a_secure_random_jwt_secret_32bytes
EDGE_HMAC_KEY_ESP32_GATE_01=secure_edge_device_hmac_secret_key_gate01
EDGE_HMAC_KEY_EDGE_01=secure_edge_device_hmac_secret_key_edge01

# Operational Mode Flags (LIVE or MOCK / LOCAL_FALLBACK)
GEMINI_MODE=LIVE
QPIAI_OPT_MODE=LIVE
QPIAI_QCLOUD_MODE=LOCAL_SIMULATOR
CALLING_MODE=MOCK
EXTERNAL_DATA_MODE=SIMULATED

